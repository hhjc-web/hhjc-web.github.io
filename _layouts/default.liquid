<!doctype html>
{%- comment -%}
  al_rtl owns the language and direction attributes when it is installed, because
  `dir` has to sit on <html> for the browser's bidi handling, CSS logical
  properties and Tailwind's rtl: variant to apply to the whole document.

  Captured into a variable rather than wrapping the <html> tag in a conditional:
  a conditional there stops the tag being a single static element, and Prettier
  then re-indents the entire document body. The guard keeps this parse-safe —
  without the plugin the tag does not exist and Liquid fails on every page.
{%- endcomment -%}
{%- capture html_attributes -%}
  {%- if site.plugins contains 'al_rtl' -%}
    {%- include plugins/al_rtl_html_attrs.liquid -%}
  {%- else -%}
    lang="{{ site.lang }}"
  {%- endif -%}
{%- endcapture -%}
<html {{ html_attributes }}>
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}

    <!-- Site customizations (tech-purple theme) -->
    <style>
      /* ================= Theme palette (unify to violet) ================= */
      :root {
        --global-theme-color: #6d28d9;
        --global-hover-color: #7c3aed;
      }
      html[data-theme="dark"] {
        --global-theme-color: #a78bfa;
        --global-hover-color: #c4b5fd;
      }

      /* ================= Navbar ================= */
      .navbar {
        background: linear-gradient(120deg, #1e1b4b 0%, #4c1d95 55%, #7c3aed 100%) !important;
        opacity: 1 !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 6px 24px rgba(30, 27, 75, 0.35);
      }
      .navbar .navbar-brand.title {
        font-weight: 700 !important;
        letter-spacing: 0.01em;
      }
      .navbar .navbar-brand.title .font-weight-bold {
        font-weight: 700 !important;
      }
      .navbar .navbar-brand,
      .navbar .nav-link,
      .navbar #search-toggle,
      .navbar #search-toggle .nav-link,
      .navbar #search-toggle i,
      .navbar #light-toggle,
      .navbar #light-toggle i,
      .navbar #light-toggle .fa-half-sun-moon::before,
      .navbar #light-toggle .fa-half-sun-moon::after {
        color: #ffffff !important;
      }
      .navbar .navbar-nav .nav-item .nav-link {
        font-weight: 500;
        letter-spacing: 0.02em;
        border-radius: 8px;
        padding: 0.35rem 0.7rem !important;
        transition:
          background-color 0.18s ease,
          color 0.18s ease;
      }
      .navbar .nav-link:hover,
      .navbar .navbar-brand:hover,
      .navbar #light-toggle:hover,
      .navbar #search-toggle:hover,
      .navbar #light-toggle:hover .fa-half-sun-moon::before,
      .navbar #light-toggle:hover .fa-half-sun-moon::after {
        color: #ede9fe !important;
      }
      .navbar .navbar-nav .nav-item .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.12);
      }
      .navbar .nav-item.active > .nav-link {
        color: #ffffff !important;
        background-color: rgba(255, 255, 255, 0.16) !important;
        font-weight: 700;
      }
      .navbar .navbar-toggler .icon-bar {
        background-color: #ffffff !important;
      }

      /* ================= Name: consistent weight (no bold + thin mix) ================= */
      .post-title,
      .post-title .font-weight-bold {
        color: var(--global-text-color) !important;
        font-weight: 800 !important;
      }

      /* ================= Profile photo ================= */
      .profile img,
      .profile figure {
        max-width: 200px;
      }
      @media (min-width: 576px) {
        .profile {
          width: auto;
        }
      }

      /* ================= Tech section headings ================= */
      .section-title {
        font-family: ui-monospace, "JetBrains Mono", "SFMono-Regular", Menlo, Consolas, monospace;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 1rem;
        font-weight: 700;
        color: var(--global-theme-color);
        border-left: 4px solid var(--global-theme-color);
        padding-left: 0.75rem;
        margin: 0 0 1.2rem;
      }
      .section-title a,
      .section-title a:hover {
        color: inherit;
        text-decoration: none;
      }

      /* ================= Home sections with breathing room ================= */
      .home-section {
        margin: 2.6rem 0 3rem;
      }
      .home-section.tinted {
        background: linear-gradient(180deg, rgba(124, 58, 237, 0.07), rgba(124, 58, 237, 0.02));
        border: 1px solid rgba(124, 58, 237, 0.14);
        border-radius: 14px;
        padding: 1.6rem 1.6rem 0.4rem;
      }

      /* ================= Gradient divider with glowing diamond ================= */
      .section-divider {
        height: 1px;
        width: 70%;
        margin: 3rem auto;
        background: linear-gradient(90deg, transparent, rgba(124, 58, 237, 0.55), transparent);
        position: relative;
      }
      .section-divider::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        width: 8px;
        height: 8px;
        transform: translate(-50%, -50%) rotate(45deg);
        background: var(--global-theme-color);
        box-shadow: 0 0 10px rgba(124, 58, 237, 0.6);
      }

      /* ================= Publications page polish ================= */
      .publications h2.bibliography {
        color: var(--global-theme-color) !important;
        border-top: none !important;
        border-bottom: 2px solid var(--global-theme-color);
        border-left: 4px solid var(--global-theme-color);
        text-align: left !important;
        font-family: ui-monospace, "JetBrains Mono", Menlo, Consolas, monospace;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 1.1rem;
        font-weight: 700;
        padding: 0 0 0.4rem 0.75rem;
        margin: 2.4rem 0 1.4rem !important;
      }
      .publications .row {
        padding: 0.9rem 1rem;
        margin-bottom: 0.6rem;
        border-radius: 12px;
        border: 1px solid transparent;
        transition:
          background-color 0.18s ease,
          border-color 0.18s ease,
          transform 0.18s ease;
      }
      .publications .row:hover {
        background: linear-gradient(180deg, rgba(124, 58, 237, 0.06), rgba(124, 58, 237, 0.02));
        border-color: rgba(124, 58, 237, 0.16);
        transform: translateY(-2px);
      }
      .publications .title {
        font-weight: 600;
        color: var(--global-text-color);
      }
      .publications .author,
      .publications .periodical {
        color: var(--global-text-color-light);
      }
      .publications .periodical .pub-meta {
        color: var(--global-theme-color);
        font-weight: 600;
      }
      .publications .links a.btn {
        color: var(--global-theme-color) !important;
        border: 1px solid var(--global-theme-color) !important;
        border-radius: 8px !important;
        font-size: 0.8rem;
        letter-spacing: 0.03em;
        transition:
          background-color 0.15s ease,
          color 0.15s ease;
      }
      .publications .links a.btn:hover {
        background-color: var(--global-theme-color) !important;
        color: #ffffff !important;
      }

      /* Homepage selected publications: hide volume + Bib toggle */
      .home-section .pub-meta,
      .home-section .links a.bibtex {
        display: none !important;
      }

      /* ================= Dark-mode navbar variant ================= */
      html[data-theme="dark"] .navbar {
        background: linear-gradient(120deg, #0b0716 0%, #1e1b4b 55%, #4c1d95 100%) !important;
      }
    </style>
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% assign toc_collapse = page.toc.collapse | default: 'expanded' %}
        {% assign toc_collapse_depth = page.toc.collapse_depth | default: '' %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
